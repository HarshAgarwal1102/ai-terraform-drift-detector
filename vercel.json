{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "installCommand": "python -m pip install --disable-pip-version-check --no-input --require-hashes --no-deps --only-binary=:all: -r deploy/vercel/requirements.txt",
  "functions": {
    "index.py": {
      "excludeFiles": "{{.artifacts,.github,build,dist,ci,docs,schemas,scripts,security,terraform,src/ai_engine,tests/{[!f]*,fixtures/[!d]*}}/**,tests/*.py,**/*.test.js,*.{md,txt},**/{.terraform/**,*.tf{state,plan,vars}*,tfplan,plan.json,.env*,*.{pem,key,pfx,dmg},.coverage*}}"
    }
  }
}
