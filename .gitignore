# -------------------------------------------------
# Terraform
# -------------------------------------------------

# Local .terraform directories
.terraform/

# Terraform state files (never commit state)
*.tfstate
*.tfstate.*

# Terraform plan artifacts (may contain resource IDs / sensitive values)
tfplan
*.tfplan
plan.json

# Infracost output (Task 10.1): raw and sanitised cost reports are produced outside the
# repository and must never be committed; committed test fixtures are the only exception.
infracost*.json
cost_run.json
!tests/fixtures/**/infracost*.json
!tests/fixtures/**/cost_run.json

# Crash log files
crash.log
crash.*.log

# Variable override files (may contain secrets)
*.tfvars
*.tfvars.json
# Allow example/dev tfvars that contain no secrets
!dev.tfvars

# NOTE: .terraform.lock.hcl is intentionally NOT ignored.
# The provider lock file should be committed for reproducible builds.

# -------------------------------------------------
# Downloaded / extracted validation artifacts (PROJECT_PLAN.md rule 15)
# -------------------------------------------------
.artifacts/

# -------------------------------------------------
# Environment / Secrets
# -------------------------------------------------
.env
.env.*

# The active Azure account (scripts/onboard_azure_account.sh --config): its tenant,
# subscription and client IDs stay on your machine. Only the template is committed.
# Any name or backup of it (azure-account.json.bak, azure-account.2026-10.json, ...).
config/azure-account*
!config/azure-account.example.json

# -------------------------------------------------
# OS / Editor
# -------------------------------------------------
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
*.code-workspace

# -------------------------------------------------
# Python
# -------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
